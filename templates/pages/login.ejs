<!doctype html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | Node.js HTTP Server</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <a href="/">NodeJS Server</a>
            </div>
            <ul class="nav-menu">
                <li><a href="/">Главная</a></li>
                <li><a href="/about">О нас</a></li>
                <li><a href="/contact">Контакты</a></li>
                <li class="user-menu">
                    <a href="/login" class="active">Вход</a>
                    <a href="/register">Регистрация</a>
                </li>
            </ul>
        </div>
    </nav>

    <main class="main">
        <div class="container">
            <div class="login-wrapper">
                <div class="login-container">
                    <div class="login-header">
                        <h2>Вход в систему</h2>
                        <p>Введите свои данные для входа</p>
                    </div>

                    <form id="loginForm" class="login-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="email" placeholder="example@mail.com" required />
                        </div>

                        <div class="form-group">
                            <label for="password">Пароль</label>
                            <input type="password" id="password" name="password" placeholder="••••••••" required />
                        </div>

                        <button type="submit" class="btn btn-primary btn-block">Войти</button>
                    </form>

                    <% if (googleEnabled) { %>
                    <div class="login-oauth" style="margin-top: 1.5rem; text-align: center;">
                        <p style="color: #666; margin-bottom: 0.5rem;">Или войдите через</p>
                        <a href="/api/v1/auth/google" class="btn btn-google" style="
                            display: inline-block;
                            background: #ffffff;
                            color: #000000;
                            padding: 0.75rem 2rem;
                            border: 1px solid #ddd;
                            text-decoration: none;
                            font-family: 'Share Tech Mono', monospace;
                            transition: all 0.3s;
                        ">
                        <svg width="20" height="20" viewBox="0 0 48 48" style="vertical-align: middle; margin-right: 0.5rem;">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                        <path fill="#FBBC05" d="M10.53 28.59A14.5 14.5 0 0 1 9.5 24c0-1.59.38-3.09 1.03-4.41l-7.98-6.19A23.96 23.96 0 0 0 0 24c0 3.77.87 7.35 2.56 10.6l7.97-6.01z"/>
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.01C6.51 42.62 14.62 48 24 48z"/>
                        </svg>
                        Войти через Google
                        </a>
                    </div>
                    <% } %>

                    <div id="loginMessage" class="form-message" style="margin-top: 1rem;"></div>

                    <div class="login-info">
                        <div class="info-box">
                            <h4>Тестовые данные:</h4>
                            <p><strong>Email:</strong> admin@example.com</p>
                            <p><strong>Пароль:</strong> admin123</p>
                            <hr />
                            <p><strong>Email:</strong> user@example.com</p>
                            <p><strong>Пароль:</strong> password123</p>
                        </div>
                    </div>

                    <div class="login-footer" style="margin-top: 1rem; text-align: center;">
                        <p>Нет аккаунта? <a href="/register" style="color: #ff0000;">Зарегистрироваться</a></p>
                        <a href="/">Вернуться на главную</a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <p>&copy; 2026 Node.js HTTP Server. Все права защищены.</p>
        </div>
    </footer>

    <script src="/js/authManager.js"></script>
    <script src="/js/auth.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
