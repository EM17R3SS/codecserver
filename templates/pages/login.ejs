<!-- templates/pages/login.ejs -->
<!doctype html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | Node.js HTTP Server</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <a href="/">NodeJS Server</a>
            </div>
            <ul class="nav-menu">
                <li><a href="/">Главная</a></li>
                <li><a href="/about">О нас</a></li>
                <li><a href="/contact">Контакты</a></li>
                <li><a href="/login" class="active">Вход</a></li>
            </ul>
        </div>
    </nav>

    <main class="main">
        <div class="container">
            <div class="login-wrapper">
                <div class="login-container">
                    <div class="login-header">
                        <h2>Вход в систему</h2>
                        <p>Введите свои данные для входа</p>
                    </div>

                    <form id="loginForm" class="login-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="email" placeholder="example@mail.com" required />
                        </div>

                        <div class="form-group">
                            <label for="password">Пароль</label>
                            <input type="password" id="password" name="password" placeholder="••••••••" required />
                        </div>

                        <button type="submit" class="btn btn-primary btn-block">
                            Войти
                        </button>
                    </form>

                    <div id="loginMessage" class="form-message" style="margin-top: 1rem;"></div>

                    <div class="login-info">
                        <div class="info-box">
                            <h4>Тестовые данные:</h4>
                            <p><strong>Email:</strong> admin@example.com</p>
                            <p><strong>Пароль:</strong> admin123</p>
                            <hr />
                            <p><strong>Email:</strong> ivan@example.com</p>
                            <p><strong>Пароль:</strong> password123</p>
                            <hr />
                            <p><small>Сначала запустите <code>npm run seed</code></small></p>
                        </div>
                    </div>

                    <div class="login-footer" style="margin-top: 1rem; text-align: center;">
                        <p>Нет аккаунта? <a href="/register" style="color: #ff0000;">Зарегистрироваться</a></p>
                        <a href="/">Вернуться на главную</a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer">
        <div class="container">
            <p>&copy; 2026 Node.js HTTP Server. Все права защищены.</p>
        </div>
    </footer>

    <script src="/public/js/auth.js"></script>
</body>
</html>
