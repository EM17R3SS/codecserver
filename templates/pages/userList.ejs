<!doctype html>
<html lang="ru">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Управление пользователями | Node.js HTTP Server</title>
        <link rel="stylesheet" href="/css/style.css" />
    </head>
    <body>
        <nav class="navbar">
            <div class="container">
                <div class="nav-brand">
                    <a href="/">NodeJS Server</a>
                </div>
                <ul class="nav-menu">
                    <li><a href="/">Главная</a></li>
                    <li><a href="/about">О нас</a></li>
                    <li><a href="/contact">Контакты</a></li>
                    <li class="user-menu">
                        <!-- Будет заполняться через JavaScript -->
                        <a href="/login">Вход</a>
                        <a href="/register">Регистрация</a>
                    </li>
                </ul>
            </div>
        </nav>

        <main class="main">
            <div class="container">
                <div class="page-header">
                    <h1>Управление пользователями</h1>
                    <p>
                        Всего пользователей:
                        <span id="userCount"><%=userCount%></span>
                    </p>
                    <div class="header-actions">
                        <a
                            href="/api/v1/users?format=json"
                            class="btn btn-secondary"
                            target="_blank"
                            >Получить JSON</a
                        >
                        <button
                            onclick="refreshUsers()"
                            class="btn btn-secondary"
                        >
                            Обновить
                        </button>
                    </div>
                </div>

                <div class="add-user-section">
                    <h2>Добавить пользователя</h2>
                    <form id="addUserForm" class="add-user-form">
                        <div class="form-group">
                            <input
                                type="text"
                                id="userName"
                                placeholder="Имя пользователя"
                                required
                            />
                        </div>
                        <div class="form-group">
                            <input
                                type="email"
                                id="userEmail"
                                placeholder="Email"
                                required
                            />
                        </div>
                        <div class="form-group">
                            <input
                                type="password"
                                id="userPassword"
                                placeholder="Пароль (опционально)"
                            />
                            <small class="form-hint">Оставьте пустым для генерации</small>
                        </div>
                        <button type="submit" class="btn btn-primary">Добавить пользователя</button>
                        <div id="addUserMessage" class="form-message"></div>
                    </form>
                </div>

                <div class="users-section">
                    <div class="users-table-container">
                        <table class="users-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Имя</th>
                                    <th>Email</th>
                                    <th>Дата регистрации</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody id="usersBody">
                                <tr><td colspan="5">Загрузка...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>

        <footer class="footer">
            <div class="container">
                <p>&copy; 2026 Node.js HTTP Server. Все права защищены.</p>
            </div>
        </footer>

        <script src="/js/authManager.js"></script>
        <script src="/js/main.js"></script>
    </body>
</html>
