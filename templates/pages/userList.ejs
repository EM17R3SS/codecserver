<!doctype html>
<html lang="ru">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Управление пользователями | Node.js HTTP Server</title>
        <link rel="stylesheet" href="/css/style.css" />
    </head>
    <body>
        <nav class="navbar">
            <div class="container">
                <div class="nav-brand">
                    <a href="/">NodeJS Server</a>
                </div>
                <ul class="nav-menu">
                    <li><a href="/">Главная</a></li>
                    <li><a href="/about">О нас</a></li>
                    <li><a href="/contact">Контакты</a></li>
                    <li class="user-menu">
                        <a href="/login">Вход</a>
                        <a href="/register">Регистрация</a>
                    </li>
                </ul>
            </div>
        </nav>

        <main class="main">
            <div class="container">
                <div class="page-header">
                    <h1>Управление пользователями</h1>
                    <p>
                        Всего пользователей:
                        <span id="userCount"><%=userCount%></span>
                    </p>
                    <div class="header-actions">
                        <a
                            href="/api/v1/users?format=json"
                            class="btn btn-secondary"
                            target="_blank"
                            >Получить JSON</a
                        >
                        <button id="refreshUsers" class="btn btn-secondary">
                            Обновить
                        </button>
                    </div>
                </div>

                <div class="add-user-section">
                    <h2>Добавить пользователя</h2>
                    <form id="addUserForm" class="add-user-form">
                        <div class="form-group">
                            <input
                                type="text"
                                id="userName"
                                placeholder="Имя пользователя"
                                required
                            />
                        </div>
                        <div class="form-group">
                            <input
                                type="email"
                                id="userEmail"
                                placeholder="Email"
                                required
                            />
                        </div>
                        <div class="form-group">
                            <input
                                type="password"
                                id="userPassword"
                                placeholder="Пароль (опционально)"
                            />
                            <small class="form-hint">Оставьте пустым для генерации</small>
                        </div>
                        <button type="submit" class="btn btn-primary">Добавить пользователя</button>
                        <div id="addUserMessage" class="form-message"></div>
                    </form>
                </div>

                <div class="users-section">
                    <div class="users-table-container">
                        <table class="users-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Имя</th>
                                    <th>Email</th>
                                    <th>Дата регистрации</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody id="usersBody">
                                <tr><td colspan="5">Загрузка...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div id="editUserModal" class="modal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8);">
                    <div class="modal-content" style="background: #0a0a0a; border: 2px solid #ff0000; margin: 10% auto; padding: 2rem; max-width: 400px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                            <h2 style="color: #ff0000;">Редактировать пользователя</h2>
                            <button onclick="closeEditUserModal()" style="background: none; border: none; color: #ff0000; font-size: 2rem; cursor: pointer;">&times;</button>
                        </div>
                        <form id="editUserForm">
                            <input type="hidden" id="editUserId" />
                            <div class="form-group">
                                <label for="editUserName" style="color: #ff0000;">Имя</label>
                                <input type="text" id="editUserName" required />
                            </div>
                            <div class="form-group">
                                <label for="editUserEmail" style="color: #ff0000;">Email</label>
                                <input type="email" id="editUserEmail" required />
                            </div>
                            <div class="form-group">
                                <label for="editUserRole" style="color: #ff0000;">Роль</label>
                                <select id="editUserRole" style="width: 100%; padding: 0.75rem; background: #111111; border: 1px solid #ff0000; color: #ffffff; font-family: 'Share Tech Mono', monospace; font-size: 1rem;">
                                    <option value="user">Пользователь</option>
                                    <option value="admin">Администратор</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary" style="width: 100%;">Сохранить</button>
                            <div id="editUserMessage" class="form-message" style="margin-top: 1rem;"></div>
                        </form>
                    </div>
                </div>

                <div id="changePasswordModal" class="modal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8);">
                    <div class="modal-content" style="background: #0a0a0a; border: 2px solid #ff0000; margin: 10% auto; padding: 2rem; max-width: 400px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                            <h2 style="color: #ff0000;">Сменить пароль</h2>
                            <button id="closePasswordButton" style="background: none; border: none; color: #ff0000; font-size: 2rem; cursor: pointer;">&times;</button>
                        </div>
                        <form id="changePasswordForm">
                            <input type="hidden" id="changeUserId" />
                            <div class="form-group">
                                <label for="newPassword" style="color: #ff0000;">Новый пароль</label>
                                <input type="password" id="newPassword" placeholder="Новый пароль" required minlength="8" />
                            </div>
                            <div class="form-group">
                                <label for="confirmPassword" style="color: #ff0000;">Подтвердите пароль</label>
                                <input type="password" id="confirmPassword" placeholder="Подтвердите пароль" required minlength="8" />
                            </div>
                            <button type="submit" class="btn btn-primary" style="width: 100%;">Сохранить</button>
                            <div id="passwordMessage" class="form-message" style="margin-top: 1rem;"></div>
                        </form>
                    </div>
                </div>
            </div>
        </main>

        <footer class="footer">
            <div class="container">
                <p>&copy; 2026 Node.js HTTP Server. Все права защищены.</p>
            </div>
        </footer>

        <script src="/js/authManager.js"></script>
        <script src="/js/auth.js"></script>
        <script src="/js/main.js"></script>
    </body>
</html>
